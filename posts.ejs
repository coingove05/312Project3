
<!DOCTYPE html>

<html>
    <head>
        <title>Stories</title>
    </head>
    <body>
        <h1>Stories</h1>
        <% posts.forEach(post => { %>
            <article>
                <h2><%= post.title %></h2>

                <p>By <%= post.creator %></p>

                <p><%= post.story %></p>

                <p><%= post.id %></p>
            </article>
        
            <% }) %>

    </body>




</html>



